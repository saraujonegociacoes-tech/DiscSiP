{
  "name": "bluedesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-guard.mjs",
    "dev": "next dev --turbopack",
    "sync:helper": "node scripts/sync-helper.mjs",
    "import:leads": "node scripts/import-leads.mjs",
    "backup:leads": "node scripts/backup-leads.mjs",
    "import:cs-cards": "node scripts/import-cs-cards.mjs",
    "probe:webrtc": "node scripts/serve-probe.mjs",
    "probe:financeiro": "node scripts/probe-financeiro-fields.mjs",
    "probe:negociacao": "node scripts/probe-negociacao-fields.mjs",
    "import:financeiro": "node scripts/import-financeiro.mjs",
    "verify:financeiro": "node scripts/verify-financeiro.mjs",
    "import:negociacao": "node scripts/import-negociacao.mjs",
    "verify:negociacao": "node scripts/verify-negociacao.mjs",
    "verify:saude-empresa": "node scripts/verify-saude-empresa.mjs",
    "import:minutas": "node scripts/import-minutas.mjs",
    "prebuild": "node scripts/sync-helper.mjs",
    "prebuild:cf": "node scripts/sync-helper.mjs",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build && node -e \"const fs=require('fs');fs.renameSync('.open-next/worker.js','.open-next/_worker.js');fs.readdirSync('.open-next/assets').forEach(f=>fs.cpSync('.open-next/assets/'+f,'.open-next/'+f,{recursive:true}));const init=fs.readFileSync('.open-next/cloudflare/init.js','utf8');fs.writeFileSync('.open-next/cloudflare/init.js',init.replace('__ASSETS_RUN_WORKER_FIRST__: false','__ASSETS_RUN_WORKER_FIRST__: true'));\"",
    "preview": "opennextjs-cloudflare build && wrangler pages dev",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.575.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "sip.js": "^0.21.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.98.0"
  }
}
