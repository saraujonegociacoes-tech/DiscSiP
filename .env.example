# Copie este arquivo para .env.local e preencha os valores
# NÃO commite o .env.local — ele já está no .gitignore

# Supabase — obter em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Webhook do Make para notificação pós-chamada (opcional; sem ela, não notifica)
# URL do cenário "Custom webhook" no Make
MAKE_WEBHOOK_URL=https://hook.make.com/SEU_WEBHOOK

# Carga histórica do dashboard de leads (scripts/import-leads.mjs) — só backend/CLI
# SUPABASE_SERVICE_ROLE_KEY: Settings > API > service_role (NUNCA expor no frontend)
# PIPEFY_TOKEN: token pessoal da API do Pipefy
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
PIPEFY_TOKEN=seu_token_pipefy_aqui
PIPEFY_PIPE_ID=seu_pipe_id_aqui

# Feature flags do dashboard de leads (build-time; NEXT_PUBLIC_ é inlinado no build)
# NEXT_PUBLIC_LEADS_ENABLED: liga o dashboard de leads. Sem ela (ou !=1), /leads mostra
#   "Em breve". Deixe DESLIGADA em produção até o lançamento; ligue localmente pra desenvolver.
# NEXT_PUBLIC_LEADS_REALTIME: liga o Realtime dos leads (senão o hook nem abre socket).
NEXT_PUBLIC_LEADS_ENABLED=1
# NEXT_PUBLIC_LEADS_REALTIME=1