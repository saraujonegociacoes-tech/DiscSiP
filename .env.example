# Copie este arquivo para .env.local e preencha os valores
# NÃO commite o .env.local — ele já está no .gitignore

# Supabase — obter em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Webhook do Make para notificação pós-chamada (opcional; sem ela, não notifica)
# URL do cenário "Custom webhook" no Make
MAKE_WEBHOOK_URL=https://hook.make.com/SEU_WEBHOOK

# Carga histórica do dashboard de leads (scripts/import-leads.mjs) — só backend/CLI
# SUPABASE_SERVICE_ROLE_KEY: Settings > API > service_role (NUNCA expor no frontend)
# PIPEFY_TOKEN: token pessoal da API do Pipefy
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
PIPEFY_TOKEN=seu_token_pipefy_aqui
PIPEFY_PIPE_ID=seu_pipe_id_aqui

# Carga histórica do painel de Sucesso do Cliente (scripts/import-cs-cards.mjs) — domínio
# SEPARADO do dashboard de leads. Usa o mesmo PIPEFY_TOKEN/SUPABASE_SERVICE_ROLE_KEY acima.
# CS_PIPEFY_PIPE_ID: pipe "3.3 - Customer Success" no Pipefy (default 305801110).
CS_PIPEFY_PIPE_ID=305801110

# Feature flags do dashboard de leads (build-time; NEXT_PUBLIC_ é inlinado no build)
# NEXT_PUBLIC_LEADS_ENABLED: liga o dashboard de leads. Sem ela (ou !=1), /leads mostra
#   "Em breve". Deixe DESLIGADA em produção até o lançamento; ligue localmente pra desenvolver.
# NEXT_PUBLIC_LEADS_REALTIME: liga o Realtime dos leads (senão o hook nem abre socket).
NEXT_PUBLIC_LEADS_ENABLED=1
# NEXT_PUBLIC_LEADS_REALTIME=1

# Feature flag do painel de Sucesso do Cliente (CS) — mesmo padrão do leads, domínio
# separado. Sem ela (ou !=1), /cs mostra "Em breve".
NEXT_PUBLIC_CS_ENABLED=1

# Feature flag do Painel do CEO — mesmo padrão. Sem ela (ou !=1), /ceo mostra "Em breve".
# Deixe DESLIGADA até o Sprint 1 (Financeiro) estar no ar: a rota já existe e o papel `ceo`
# aterrissa nela, então ligar antes de haver dado só mostraria abas vazias.
# NÃO é a trava de acesso — quem barra /ceo é o middleware (papel `ceo` + admin) e, a partir
# do Sprint 1, a guarda ceo_current_role() dentro das RPCs. A flag só controla o lançamento.
# NEXT_PUBLIC_CEO_ENABLED=1

# ── Aquecimento de números WhatsApp — domínio separado (só manager/admin) ──────
# NEXT_PUBLIC_WARMUP_ENABLED: liga o módulo /aquecimento. Sem ela (ou !=1), mostra
#   "Em breve". Deixe DESLIGADA em produção até o lançamento; ligue localmente.
# NEXT_PUBLIC_WARMUP_ENABLED=1
#
# MAKE_WEBHOOK_URL_WARMUP: webhook do cenário "Aquecimento · Disparo" no Make.
#   Sem ela, o disparo real é no-op (o histórico ainda é gravado). Variável PRÓPRIA
#   para não misturar com o MAKE_WEBHOOK_URL do discador.
MAKE_WEBHOOK_URL_WARMUP=https://hook.make.com/SEU_WEBHOOK_AQUECIMENTO
# WARMUP_CRON_SECRET: segredo do endpoint POST /api/aquecimento/tick (o GitHub
#   Actions manda no header X-Warmup-Cron-Secret). Gere um valor aleatório longo.
WARMUP_CRON_SECRET=troque_por_um_segredo_aleatorio
# MAKE_CALLBACK_SECRET: segredo do callback POST /api/aquecimento/dispatch-result
#   (o Make manda no header X-Warmup-Callback-Secret com o resultado do envio).
MAKE_CALLBACK_SECRET=troque_por_outro_segredo_aleatorio